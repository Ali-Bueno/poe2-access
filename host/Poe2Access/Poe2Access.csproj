<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mod's one executable: starts the game, keeps its data current, reads it (no window, no overlay, no administrator rights) and runs the plugin. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Poe2Access</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Poe2Accessibility\Localization.cs" Link="Launcher\Localization.cs" />
    <!-- The plugin's PRISM binding, for the startup speech. -->
    <Compile Include="..\..\Poe2Accessibility\Services\Speech\PrismLibrary.cs" Link="Launcher\PrismLibrary.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameReader\GameReader.csproj" />
    <ProjectReference Include="..\..\tools\Poe2UiExtract\Poe2UiExtract.csproj" />
  </ItemGroup>

</Project>
