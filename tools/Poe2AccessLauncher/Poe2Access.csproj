<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Poe2Access</AssemblyName>
    <RootNamespace>Poe2AccessLauncher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <HostOutputDir>$(MSBuildThisFileDirectory)..\..\host\Poe2AccessHost\bin\Release\net10.0-windows\win-x64\</HostOutputDir>
  </PropertyGroup>

  <!-- Deploys the launcher beside Poe2AccessHost.exe so it can be started by double-click. -->
  <!-- Never from a self-contained publish (the test package): its runtimeconfig needs the runtime beside it. -->
  <Target Name="CopyToHost" AfterTargets="Build" Condition="Exists('$(HostOutputDir)') And '$(SelfContained)' != 'true'">
    <Copy SourceFiles="$(OutDir)$(TargetName).exe;$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).runtimeconfig.json;$(OutDir)$(TargetName).deps.json"
          DestinationFolder="$(HostOutputDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
