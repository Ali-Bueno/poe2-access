<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGGPK3.LibBundle3" Version="2.7.5" />
    <!-- The Korean client (Kakao Games) keeps Bundles2 and the FMOD banks inside Content.ggpk. -->
    <PackageReference Include="LibGGPK3.LibGGPK3" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin's own sorting of attack animations (pure), so hit-times counts the attacks the mod warns of. -->
    <Compile Include="..\..\Poe2Accessibility\Services\Combat\DodgeThreats.cs" Link="DodgeThreats.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Combat\DodgeCoverage.cs" Link="DodgeCoverage.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Audio\Breakables.cs" Link="Breakables.cs" />
    <!-- The handlers the plugin applies to a stat's value, so mod-stats fails on one it does not know. -->
    <Compile Include="..\..\Poe2Accessibility\Services\Inventory\StatHandlers.cs" Link="StatHandlers.cs" />
    <!-- The names the plugin's rules match, so game-names checks the very lists the rules use. -->
    <Compile Include="..\..\Poe2Accessibility\Services\Core\GameNames.cs" Link="GameNames.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Combat\EnemyStates.cs" Link="EnemyStates.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Combat\ShieldStance.cs" Link="ShieldStance.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Combat\PerfectTimingChannel.cs" Link="PerfectTimingChannel.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Player\BuffIds.cs" Link="BuffIds.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Trials\TrialTraps.cs" Link="TrialTraps.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Trials\ChaosTrial.cs" Link="ChaosTrial.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Leagues\LeaguePieces.cs" Link="LeaguePieces.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Trials\TrialDoors.cs" Link="TrialDoors.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Trials\TrialWater.cs" Link="TrialWater.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Trials\TrialArt.cs" Link="TrialArt.cs" />
    <Compile Include="..\..\Poe2Accessibility\Services\Scanner\MinimapIconIds.cs" Link="MinimapIconIds.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only needed at run time for the bundle-extraction mode; the file lives beside the exe when
         present, but its absence must never fail the build (e.g. the catalog mode never touches it). -->
    <None Include="..\..\external\oodle\oo2core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\external\oodle\oo2core.dll')" />
  </ItemGroup>

</Project>
