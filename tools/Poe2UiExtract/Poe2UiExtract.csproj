<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGGPK3.LibBundle3" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only needed at run time for the bundle-extraction mode; the file lives beside the exe when
         present, but its absence must never fail the build (e.g. the catalog mode never touches it). -->
    <None Include="..\oo2core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\oo2core.dll')" />
  </ItemGroup>

</Project>
