index 0000000..c50d60f
--- /dev/null
+++ b/GameHelper/RemoteObjects/States/InGameStateObjects/AreaInstanceLayout.cs
@@ -0,0 +1,140 @@
+// <copyright file="AreaInstanceLayout.cs" company="None">
+// Copyright (c) None. All rights reserved.
+// </copyright>
+
+namespace GameHelper.RemoteObjects.States.InGameStateObjects
+{
+    using System;
+    using System.Runtime.InteropServices;
+    using GameHelper.Utils;
+    using GameOffsets.Natives;
+    using GameOffsets.Objects.States.InGameState;
+
+    /// <summary>
+    ///     Reads an area instance through the offsets this game build really uses: judged once per area, searched again
+    ///     while they do not hold what they must, so a patch that moves a field does not need a new GameHelper.
+    /// </summary>
+    public sealed class AreaInstanceLayout
+    {
+        // Past every field seen so far (0.5.3 reached 0xE90) and inside what the game allocates.
+        internal const int BlockSize = 0x2000;
+        private const long SearchEveryMs = 500;
+
+        private IntPtr judged;
+        private long nextSearchAt;
+
+        /// <summary>Gets where the fields are read from now.</summary>
+        public AreaFields Fields { get; private set; } = AreaFields.Measured;
+
+        /// <summary>Gets the outcome of the last search; negative fields were not found.</summary>
+        public AreaFields LastFound { get; private set; } = AreaFields.Measured;
+
+        /// <summary>Gets a value indicating whether the current area's world fields were all found.</summary>
+        public bool HasWorld { get; private set; }
+
+        /// <summary>The area instance at <paramref name="address"/>; <paramref name="moved"/> says the fields changed.</summary>
+        internal AreaInstanceOffsets Read(SafeMemoryHandle reader, IntPtr address, out bool moved)
+        {
+            moved = false;
+            var block = reader.ReadMemoryArray<byte>(address, BlockSize);
+            if (block.Length == 0)
+            {
+                return reader.ReadMemory<AreaInstanceOffsets>(address);
+            }
+
+            if (address != this.judged && Environment.TickCount64 >= this.nextSearchAt)
+            {
+                moved = this.Judge(reader, address, block);
+            }
+
+            return Compose(block, this.Fields);
+        }
+
+        /// <summary>The area instance at <paramref name="address"/> through the fields known now.</summary>
+        internal AreaInstanceOffsets Read(SafeMemoryHandle reader, IntPtr address)
+        {
+            var block = reader.ReadMemoryArray<byte>(address, BlockSize);
+            return block.Length == 0 ? reader.ReadMemory<AreaInstanceOffsets>(address) : Compose(block, this.Fields);
+        }
+
+        private static AreaInstanceOffsets Compose(byte[] block, AreaFields at)
+        {
+            var data = default(AreaInstanceOffsets);
+            data.CurrentAreaLevel = block[at.Level];
+            data.CurrentAreaHash = MemoryMarshal.Read<uint>(block.AsSpan(at.Hash));
+            data.Environments = MemoryMarshal.Read<StdVector>(block.AsSpan(at.Environments));
+            data.PlayerInfo.ServerDataPtr = MemoryMarshal.Read<IntPtr>(block.AsSpan(at.ServerData));
+            data.PlayerInfo.LocalPlayerPtr = MemoryMarshal.Read<IntPtr>(block.AsSpan(at.LocalPlayer));
+            data.Entities = MemoryMarshal.Read<EntityListStruct>(block.AsSpan(at.Entities));
+            data.TerrainMetadata = ReadTerrain(block, at.Terrain);
+            return data;
+        }
+
+        /// <summary>The terrain, read from the block: its fields move as the struct's remap says.</summary>
+        private static TerrainStruct ReadTerrain(byte[] block, int at)
+        {
+            var size = Marshal.SizeOf<TerrainStruct>();
+            if (StructRemap<TerrainStruct>.Segments is not { } moved || at + StructRemapper.ReadSize(size, moved) > block.Length)
+            {
+                return MemoryMarshal.Read<TerrainStruct>(block.AsSpan(at));
+            }
+
+            var target = new byte[size];
+            StructRemapper.Apply(block.AsSpan(at), target, moved);
+            return MemoryMarshal.Read<TerrainStruct>(target);
+        }
+
+        private bool Judge(SafeMemoryHandle reader, IntPtr address, byte[] block)
+        {
+            var search = new AreaLayoutSearch(new GameMemory(reader));
+            var found = search.Find(block, this.Fields);
+            var fields = found.Over(this.Fields);
+            if (found.Entities >= 0)
+            {
+                OffsetHealer.FollowEntityId(search.FindEntityId(block, found.Entities, OffsetHealer.MeasuredEntityId));
+            }
+
+            var moved = fields != this.Fields;
+            this.LastFound = found;
+            this.Fields = fields;
+            this.HasWorld = found.HasWorld;
+            if (found.HasWorld)
+            {
+                this.judged = address;
+            }
+            else
+            {
+                this.nextSearchAt = Environment.TickCount64 + SearchEveryMs;
+            }
+
+            return moved;
+        }
+
+    }
+
+    /// <summary>The searches' view of the game's memory.</summary>
+    internal sealed class GameMemory : IAreaMemory
+    {
+        private readonly SafeMemoryHandle reader;
+
+        internal GameMemory(SafeMemoryHandle reader)
+        {
+            this.reader = reader;
+        }
+
+        /// <inheritdoc />
+        public byte[] Read(long address, int size) => this.reader.ReadMemoryArray<byte>(new IntPtr(address), size);
+
+        /// <inheritdoc />
+        public string EntityPath(long entity)
+        {
+            return this.reader.TryReadMemory<ItemStruct>(new IntPtr(entity), out var item) &&
+                   this.reader.TryReadMemory<EntityDetails>(item.EntityDetailsPtr, out var details)
+                ? this.reader.ReadStdWString(details.name)
+                : string.Empty;
+        }
+
+        /// <inheritdoc />
+        public string WideText(long address) => this.reader.ReadUnicodeString(new IntPtr(address));
+    }
+}
diff --git a/GameHelper/RemoteObjects/States/InGameStateObjects/AreaLayoutSearch.cs b/GameHelper/RemoteObjects/States/InGameStateObjects/AreaLayoutSearch.cs
new file mode 100644
index 0000000..0f694e2
--- /dev/null
+++ b/GameHelper/RemoteObjects/States/InGameStateObjects/AreaLayoutSearch.cs
@@ -0,0 +1,322 @@
+// <copyright file="AreaLayoutSearch.cs" company="None">
+// Copyright (c) None. All rights reserved.
+// </copyright>
+
+namespace GameHelper.RemoteObjects.States.InGameStateObjects
+{
+    using System;
+    using System.Linq;
+    using System.Runtime.InteropServices;
+    using GameHelper.Utils;
+    using GameOffsets.Natives;
+    using GameOffsets.Objects.States.InGameState;
+
+    /// <summary>Where the fields of <see cref="AreaInstanceOffsets"/> sit in an area instance; negative when not found.</summary>
+    public readonly record struct AreaFields(int Level, int Hash, int Environments, int ServerData, int LocalPlayer, int Entities, int Terrain)
+    {
+        /// <summary>The offsets this build of GameHelper was written for.</summary>
+        public static AreaFields Measured { get; } = new(
+            OffsetOf<AreaInstanceOffsets>(nameof(AreaInstanceOffsets.CurrentAreaLevel)),
+            OffsetOf<AreaInstanceOffsets>(nameof(AreaInstanceOffsets.CurrentAreaHash)),
+            OffsetOf<AreaInstanceOffsets>(nameof(AreaInstanceOffsets.Environments)),
+            OffsetOf<AreaInstanceOffsets>(nameof(AreaInstanceOffsets.PlayerInfo)) + OffsetOf<LocalPlayerStruct>(nameof(LocalPlayerStruct.ServerDataPtr)),
+            OffsetOf<AreaInstanceOffsets>(nameof(AreaInstanceOffsets.PlayerInfo)) + OffsetOf<LocalPlayerStruct>(nameof(LocalPlayerStruct.LocalPlayerPtr)),
+            OffsetOf<AreaInstanceOffsets>(nameof(AreaInstanceOffsets.Entities)),
+            OffsetOf<AreaInstanceOffsets>(nameof(AreaInstanceOffsets.TerrainMetadata)));
+
+        /// <summary>Gets a value indicating whether the fields everything else hangs from were all found.</summary>
+        public bool HasWorld => this.LocalPlayer >= 0 && this.Entities >= 0 && this.Terrain >= 0;
+
+        /// <summary>These fields, keeping <paramref name="known"/>'s where one was not found.</summary>
+        public AreaFields Over(AreaFields known) => new(
+            this.Level >= 0 ? this.Level : known.Level,
+            this.Hash >= 0 ? this.Hash : known.Hash,
+            this.Environments >= 0 ? this.Environments : known.Environments,
+            this.ServerData >= 0 ? this.ServerData : known.ServerData,
+            this.LocalPlayer >= 0 ? this.LocalPlayer : known.LocalPlayer,
+            this.Entities >= 0 ? this.Entities : known.Entities,
+            this.Terrain >= 0 ? this.Terrain : known.Terrain);
+
+        private static int OffsetOf<T>(string field) => Marshal.OffsetOf<T>(field).ToInt32();
+    }
+
+    /// <summary>What <see cref="AreaLayoutSearch"/> needs to read from the game.</summary>
+    public interface IAreaMemory
+    {
+        /// <summary>The bytes at <paramref name="address"/>; empty when they cannot be read.</summary>
+        byte[] Read(long address, int size);
+
+        /// <summary>The metadata path of the entity at <paramref name="entity"/>; empty when it is not one.</summary>
+        string EntityPath(long entity);
+
+        /// <summary>The zero-ended UTF-16 text at <paramref name="address"/>; empty when it cannot be read.</summary>
+        string WideText(long address);
+    }
+
+    /// <summary>
+    ///     Finds an area instance's fields by what they hold, nearest to where they were last first, so a game patch that
+    ///     inserts a member does not cost the mod its world (docs/compatibility.md in the accessibility mod).
+    /// </summary>
+    public sealed class AreaLayoutSearch
+    {
+        private const long MinPointer = 0x10000;
+        private const long MaxPointer = 0x7FFFFFFFFFFF;
+        private const int PointerStep = 8;
+        private const int Int32Step = 4;
+
+        // MSVC std::map: a sentinel node (nil flag set) whose parent is the root; the key and value follow the links.
+        private const int NodeParent = 0x08;
+        private const int NodeLeft = 0x00;
+        private const int NodeIsNil = 0x19;
+        private const int NodeKey = 0x20;
+        private const int NodeValue = 0x28;
+        private const int NodeSize = 0x30;
+        private const int MaxEntities = 500000;
+        private const int EntityBytes = 0x100;
+
+        // Bytes of the terrain tile record; the terrain's own fields have never moved, only the terrain itself.
+        private const int MaxTiles = 10000;
+
+        private const int MaxLocalPlayers = 4;
+        private const int MaxAreaLevel = 100;
+        private const int MaxEnvironments = 1024;
+        private const int NearWindow = 0x100;
+
+        // The level is one byte in a 4-byte slot: the next can hold a flag (0x0101 on a new character's Riverbank, 0.5.5f).
+        // Then 8 bytes that hold flags and three vectors, any of them empty (0.5.5f: a mine, a town, a cave).
+        private const int LevelGap = 8;
+        private const int HeaderVectors = 3;
+        private const int VectorSize = 0x18;
+
+        // A real hash is random: a value this small is the top half of a pointer.
+        private const uint MinHash = 0x10000;
+
+        private static readonly int TileRecord = Marshal.SizeOf<TileStructure>();
+        private static readonly int TotalTiles = Marshal.OffsetOf<TerrainStruct>(nameof(TerrainStruct.TotalTiles)).ToInt32();
+        private static readonly int TileDetails = Marshal.OffsetOf<TerrainStruct>(nameof(TerrainStruct.TileDetailsPtr)).ToInt32();
+        private static readonly int Walkable = Marshal.OffsetOf<TerrainStruct>(nameof(TerrainStruct.GridWalkableData)).ToInt32();
+        private static readonly int BytesPerRow = Marshal.OffsetOf<TerrainStruct>(nameof(TerrainStruct.BytesPerRow)).ToInt32();
+        private static readonly int PlayerList = Marshal.OffsetOf<ServerDataOffsets>(nameof(ServerDataOffsets.PlayerServerDataPtr)).ToInt32();
+        private static readonly int Inventories = Marshal.OffsetOf<ServerDataStructure>(nameof(ServerDataStructure.PlayerInventories)).ToInt32();
+        private static readonly int InventoryEntry = Marshal.SizeOf<InventoryArrayStruct>();
+        private static readonly int EntityMapSize = Marshal.SizeOf<StdMap>();
+
+        private readonly IAreaMemory memory;
+
+        /// <summary>Initializes a new instance of the <see cref="AreaLayoutSearch"/> class.</summary>
+        public AreaLayoutSearch(IAreaMemory memory)
+        {
+            this.memory = memory;
+        }
+
+        /// <summary>The fields found in <paramref name="block"/>, the start of an area instance, nearest to <paramref name="near"/>.</summary>
+        public AreaFields Find(byte[] block, AreaFields near)
+        {
+            var player = Nearest(near.LocalPlayer, PointerStep, block.Length - PointerStep, at => this.IsLocalPlayer(block, at));
+            var server = player < 0 ? -1 : this.FindServerData(block, player, near);
+            var level = Nearest(near.Level, Int32Step, block.Length - HeaderSize, at => IsHeader(block, at, near.Hash - near.Level));
+            return new AreaFields(
+                level,
+                level < 0 ? -1 : level + near.Hash - near.Level,
+                NearestIn(near.Environments + (player < 0 ? 0 : player - near.LocalPlayer), block, at => IsIntVector(block, at)),
+                server,
+                player,
+                Nearest(near.Entities, PointerStep, block.Length - (2 * EntityMapSize), at => this.IsEntityLists(block, at)),
+                Nearest(near.Terrain, PointerStep, block.Length - BytesPerRow - sizeof(int), at => this.IsTerrain(block, at)));
+        }
+
+        /// <summary>
+        ///     Where an entity keeps its id, nearest <paramref name="near"/>: the lists' key is that id, so the root and its
+        ///     left child must agree. Negative when they cannot be read or no place fits.
+        /// </summary>
+        public int FindEntityId(byte[] block, int entities, int near)
+        {
+            var sentinel = this.memory.Read(Int64At(block, entities), NodeSize);
+            if (sentinel.Length < NodeSize)
+            {
+                return -1;
+            }
+
+            var root = this.memory.Read(Int64At(sentinel, NodeParent), NodeSize);
+            if (root.Length < NodeSize)
+            {
+                return -1;
+            }
+
+            var left = this.memory.Read(Int64At(root, NodeLeft), NodeSize);
+            var samples = left.Length == NodeSize && left[NodeIsNil] == 0 ? new[] { root, left } : new[] { root };
+            var bodies = samples.Select(node => (Key: BitConverter.ToUInt32(node, NodeKey), Body: this.memory.Read(Int64At(node, NodeValue), EntityBytes))).ToList();
+            if (bodies.Any(entity => entity.Body.Length < EntityBytes))
+            {
+                return -1;
+            }
+
+            return Nearest(near, Int32Step, EntityBytes - sizeof(uint), at => bodies.All(entity => BitConverter.ToUInt32(entity.Body, at) == entity.Key));
+        }
+
+        private static int HeaderSize => sizeof(uint) + LevelGap + (HeaderVectors * VectorSize);
+
+        private static int Nearest(int start, int step, int limit, Func<int, bool> fits)
+        {
+            for (var distance = 0; distance <= limit; distance += step)
+            {
+                if (start + distance >= 0 && start + distance <= limit && fits(start + distance))
+                {
+                    return start + distance;
+                }
+
+                if (distance > 0 && start - distance >= 0 && start - distance <= limit && fits(start - distance))
+                {
+                    return start - distance;
+                }
+            }
+
+            return -1;
+        }
+
+        private static int NearestIn(int start, byte[] block, Func<int, bool> fits)
+        {
+            var found = Nearest(start, PointerStep, block.Length - VectorSize, fits);
+            return Math.Abs(found - start) <= NearWindow ? found : -1;
+        }
+
+        private static long Int64At(byte[] bytes, int at) => BitConverter.ToInt64(bytes, at);
+
+        private static bool IsPointer(long value) => value > MinPointer && value < MaxPointer;
+
+        private static bool IsVector(byte[] block, int at)
+        {
+            var first = Int64At(block, at);
+            var last = Int64At(block, at + PointerStep);
+            var end = Int64At(block, at + (2 * PointerStep));
+            return first == 0 ? last == 0 && end == 0 : IsPointer(first) && IsPointer(end) && first <= last && last <= end;
+        }
+
+        private static bool IsIntVector(byte[] block, int at)
+        {
+            var size = Int64At(block, at + PointerStep) - Int64At(block, at);
+            return IsVector(block, at) && Int64At(block, at) != 0 && size % sizeof(int) == 0 && size / sizeof(int) <= MaxEnvironments;
+        }
+
+        private static bool IsHeader(byte[] block, int level, int hashDistance)
+        {
+            var value = block[level];
+            if (value is 0 or > MaxAreaLevel || level + hashDistance < 0 || level + hashDistance + sizeof(uint) > block.Length ||
+                BitConverter.ToUInt32(block, level + hashDistance) < MinHash)
+            {
+                return false;
+            }
+
+            var vectors = level + sizeof(uint) + LevelGap;
+            if (vectors % PointerStep != 0)
+            {
+                return false;
+            }
+
+            for (var vector = 0; vector < HeaderVectors; vector++)
+            {
+                if (!IsVector(block, vectors + (vector * VectorSize)))
+                {
+                    return false;
+                }
+            }
+
+            return true;
+        }
+
+        private bool IsLocalPlayer(byte[] block, int at) =>
+            IsPointer(Int64At(block, at)) &&
+            this.memory.EntityPath(Int64At(block, at)).StartsWith("Metadata/Characters/", StringComparison.Ordinal);
+
+        private int FindServerData(byte[] block, int player, AreaFields near)
+        {
+            var gap = near.LocalPlayer - near.ServerData;
+            var found = Nearest(player - gap, PointerStep, player, at => this.IsServerData(Int64At(block, at)));
+            return found >= 0 ? found : player - gap;
+        }
+
+        private bool IsServerData(long pointer)
+        {
+            if (!IsPointer(pointer))
+            {
+                return false;
+            }
+
+            var list = this.memory.Read(pointer + PlayerList, VectorSize);
+            if (list.Length < VectorSize || !IsVector(list, 0))
+            {
+                return false;
+            }
+
+            var bytes = Int64At(list, PointerStep) - Int64At(list, 0);
+            if (bytes <= 0 || bytes % PointerStep != 0 || bytes / PointerStep > MaxLocalPlayers)
+            {
+                return false;
+            }
+
+            var entry = this.memory.Read(Int64At(list, 0), PointerStep);
+            if (entry.Length < PointerStep || !IsPointer(Int64At(entry, 0)))
+            {
+                return false;
+            }
+
+            var inventories = this.memory.Read(Int64At(entry, 0) + Inventories, VectorSize);
+            if (inventories.Length < VectorSize || !IsVector(inventories, 0))
+            {
+                return false;
+            }
+
+            var size = Int64At(inventories, PointerStep) - Int64At(inventories, 0);
+            return size > 0 && size % InventoryEntry == 0;
+        }
+
+        private bool IsEntityLists(byte[] block, int at) =>
+            this.IsEntityMap(block, at, false) && this.IsEntityMap(block, at + EntityMapSize, true);
+
+        private bool IsEntityMap(byte[] block, int at, bool mayBeEmpty)
+        {
+            var head = Int64At(block, at);
+            var size = Int64At(block, at + PointerStep);
+            if (!IsPointer(head) || size < (mayBeEmpty ? 0 : 1) || size > MaxEntities)
+            {
+                return false;
+            }
+
+            var sentinel = this.memory.Read(head, NodeSize);
+            if (sentinel.Length < NodeSize || sentinel[NodeIsNil] == 0)
+            {
+                return false;
+            }
+
+            var root = Int64At(sentinel, NodeParent);
+            if (size == 0)
+            {
+                return root == head;
+            }
+
+            var node = IsPointer(root) ? this.memory.Read(root, NodeSize + PointerStep) : Array.Empty<byte>();
+            return node.Length > NodeValue + PointerStep - 1 && node[NodeIsNil] == 0 && Int64At(node, NodeParent) == head &&
+                   this.memory.EntityPath(Int64At(node, NodeValue)).StartsWith("Metadata/", StringComparison.Ordinal);
+        }
+
+        private bool IsTerrain(byte[] block, int at)
+        {
+            var moved = StructRemap<TerrainStruct>.Segments;
+            var (total, details, walkable, row) = (at + StructRemapper.Follow(moved, TotalTiles), at + StructRemapper.Follow(moved, TileDetails),
+                at + StructRemapper.Follow(moved, Walkable), at + StructRemapper.Follow(moved, BytesPerRow));
+            var tilesX = Int64At(block, total);
+            var tilesY = Int64At(block, total + PointerStep);
+            if (tilesX is <= 0 or > MaxTiles || tilesY is <= 0 or > MaxTiles || !IsVector(block, details) ||
+                Int64At(block, details) == 0 || !IsVector(block, walkable))
+            {
+                return false;
+            }
+
+            var tileBytes = Int64At(block, details + PointerStep) - Int64At(block, details);
+            var walkableBytes = Int64At(block, walkable + PointerStep) - Int64At(block, walkable);
+            var bytesPerRow = BitConverter.ToInt32(block, row);
+            return tileBytes == tilesX * tilesY * TileRecord && bytesPerRow > 0 &&
+                   walkableBytes == bytesPerRow * tilesY * TileStructure.TileToGridConversion;
+        }
+    }
+}
diff --git a/GameHelper/Utils/AnimationFieldSearch.cs b/GameHelper/Utils/AnimationFieldSearch.cs
new file mode 100644
index 0000000..83c861f
--- /dev/null
+++ b/GameHelper/Utils/AnimationFieldSearch.cs
@@ -0,0 +1,223 @@
+// <copyright file="AnimationFieldSearch.cs" company="None">
+// Copyright (c) None. All rights reserved.
+// </copyright>
+
+namespace GameHelper.Utils
+{
+    using System;
+    using System.Collections.Generic;
+    using System.Linq;
+    using System.Runtime.InteropServices;
+
+    /// <summary>
+    ///     Finds an Actor's current animation by watching actors act. One reading says nothing: the id is a small number, zero
+    ///     at rest. But the game keeps a base layer far from the animation that shows, and the two agree unless a second layer
+    ///     plays on top (0.5.5f: +0x380 and +0x8B0; a crossbow's shot shows on the idle base layer, which is why they differ a third of the
+    ///     time while shooting and never for a run or a monk's blow; docs/compatibility.md). Pure.
+    /// </summary>
+    public sealed class AnimationFieldSearch
+    {
+        // An id is a row of the Animation table, some 1100 of them in 0.5.5f.
+        private const int RowLimit = 0x1000;
+
+        // At rest, in action and at rest again.
+        private const int MinChanges = 2;
+
+        // A flag or a speed stored twice agrees too, with one value; the id of a run and of a blow do not.
+        private const int MinValues = 2;
+        private const int MaxValues = 8;
+
+        // Readings in action, and neighbours are one value stored twice, not two copies of it.
+        private const int MinAgreed = 20;
+        private const int MinGap = 0x100;
+
+        // Confirming the measured place is cheap; moving a healthy field is not, so a move takes far more.
+        private const int MinAgreedToMove = 200;
+        private const int MinValuesToMove = 3;
+
+        // A layer on top parts them for a while (a third of the readings while shooting), and no more.
+        private const int AgreedPerDiffered = 1;
+        private const int ReadingsPerOutside = 100;
+
+        // The upper half of a pointer is a small number too, after a large one.
+        private const int PointerHalfFrom = 0x100;
+        private const uint PointerLowFrom = 0x10000;
+
+        // With this many actors seen acting over this many readings, some minutes of play, a pair must have shown. Something in
+        // eight actors changes within half a second of arriving (a false alarm, live 2026-11-06): the readings are what count.
+        private const int EnoughActors = 8;
+        private const int EnoughReadings = 60000;
+        private const int MaxRemembered = 256;
+
+        private readonly Dictionary<long, int[]> last = new();
+        private readonly List<Pair> pairs = new();
+        private readonly HashSet<long> acted = new();
+        private readonly List<int> live = new();
+        private int[] changes = Array.Empty<int>();
+        private int[] outside = Array.Empty<int>();
+        private int[] nonZero = Array.Empty<int>();
+        private int[] pointerHalves = Array.Empty<int>();
+        private HashSet<int>[] values = Array.Empty<HashSet<int>>();
+        private int readings;
+        private int evidence;
+
+        /// <summary>Gets a value indicating whether enough actors acted for the pair to have shown, if there is one.</summary>
+        public bool Enough => this.acted.Count >= EnoughActors && this.evidence >= EnoughReadings;
+
+        /// <summary>
+        ///     One reading of one actor, from the struct's start. <paramref name="counts"/> is false for a reading that helps find the
+        ///     pair but says nothing of its absence: a player who only runs shows a single id, however long.
+        /// </summary>
+        public void Add(long actor, ReadOnlySpan<byte> block, bool counts = true)
+        {
+            var fields = MemoryMarshal.Cast<byte, int>(block);
+            if (fields.Length < 2 || (fields[0] == 0 && fields[1] == 0))
+            {
+                return; // no longer an actor: its table pointer is gone
+            }
+
+            this.Size(fields.Length);
+            this.readings++;
+            this.evidence += counts ? 1 : 0;
+            this.last.TryGetValue(actor, out var before);
+            for (var index = 0; index < fields.Length && (before == null || index < before.Length); index++)
+            {
+                this.Read(actor, index, fields, before, counts);
+            }
+
+            foreach (var pair in this.pairs)
+            {
+                if (pair.First < fields.Length && pair.Second < fields.Length && (fields[pair.First] != 0 || fields[pair.Second] != 0))
+                {
+                    pair.Agreed += fields[pair.First] == fields[pair.Second] ? 1 : 0;
+                    pair.Differed += fields[pair.First] == fields[pair.Second] ? 0 : 1;
+                }
+            }
+
+            if (this.last.Count >= MaxRemembered)
+            {
+                this.last.Clear();
+            }
+
+            this.last[actor] = fields.ToArray();
+        }
+
+        /// <summary>The copy nearest <paramref name="near"/>; -1 until exactly one set of fields has agreed. Both read the same.</summary>
+        public int Find(int near)
+        {
+            var agreeing = this.pairs.Where(this.Agrees).ToList();
+            var fields = agreeing.SelectMany(pair => new[] { pair.First, pair.Second }).Distinct().ToList();
+            if (fields.Count == 0 || agreeing.Count != fields.Count * (fields.Count - 1) / 2)
+            {
+                return -1;
+            }
+
+            return fields.Select(field => field * sizeof(int)).OrderBy(offset => Math.Abs(offset - near)).First();
+        }
+
+        /// <summary>What the search has seen so far, for the log.</summary>
+        public string Describe()
+        {
+            var best = this.pairs.OrderByDescending(pair => pair.Agreed).Take(6)
+                .Select(pair => $"+0x{pair.First * sizeof(int):X}/+0x{pair.Second * sizeof(int):X} {pair.Agreed}/{pair.Differed} values {this.values[pair.First].Count}");
+            return $"{this.readings} readings, {this.evidence} of enemies, {this.acted.Count} acted, {this.live.Count} live fields, {this.pairs.Count} pairs: {string.Join("; ", best)}";
+        }
+
+        /// <summary>Whether what the pair at <paramref name="offset"/> showed is enough to move a field: a healthy one must not move on a coincidence.</summary>
+        public bool Proven(int offset)
+        {
+            var field = offset / sizeof(int);
+            return this.pairs.Any(pair => (pair.First == field || pair.Second == field) && this.Agrees(pair) && pair.Agreed >= MinAgreedToMove &&
+                                          this.values[pair.First].Count >= MinValuesToMove);
+        }
+
+        /// <summary>Whether the field at <paramref name="offset"/> behaves as an id on its own, for a game that stopped keeping a copy.</summary>
+        public bool Behaves(int offset)
+        {
+            var field = offset / sizeof(int);
+            return field < this.changes.Length && this.Fits(field) && this.changes[field] >= MinChanges && this.values[field].Count >= MinValues;
+        }
+
+        private void Size(int length)
+        {
+            if (this.changes.Length < length)
+            {
+                var known = this.changes.Length;
+                Array.Resize(ref this.changes, length);
+                Array.Resize(ref this.outside, length);
+                Array.Resize(ref this.nonZero, length);
+                Array.Resize(ref this.pointerHalves, length);
+                Array.Resize(ref this.values, length);
+                for (var index = known; index < length; index++)
+                {
+                    this.values[index] = new HashSet<int>();
+                }
+            }
+        }
+
+        private void Read(long actor, int index, ReadOnlySpan<int> fields, int[]? before, bool counts)
+        {
+            var value = fields[index];
+            if (value is < 0 or >= RowLimit)
+            {
+                this.outside[index]++;
+            }
+            else if (value != 0)
+            {
+                this.nonZero[index]++;
+                this.pointerHalves[index] += value >= PointerHalfFrom && index > 0 && (uint)fields[index - 1] >= PointerLowFrom ? 1 : 0;
+                if (this.values[index].Count < MaxValues)
+                {
+                    this.values[index].Add(value);
+                }
+            }
+
+            if (before != null && (before[index] == 0) != (value == 0) && ++this.changes[index] >= MinChanges && this.Fits(index))
+            {
+                this.Watch(index);
+                if (counts)
+                {
+                    this.acted.Add(actor);
+                }
+            }
+        }
+
+        private void Watch(int index)
+        {
+            if (!this.live.Contains(index))
+            {
+                foreach (var other in this.live)
+                {
+                    this.pairs.Add(new Pair(Math.Min(index, other), Math.Max(index, other)));
+                }
+
+                this.live.Add(index);
+            }
+        }
+
+        private bool Agrees(Pair pair) =>
+            (pair.Second - pair.First) * sizeof(int) >= MinGap &&
+            pair.Agreed >= MinAgreed &&
+            pair.Differed * AgreedPerDiffered <= pair.Agreed &&
+            this.Fits(pair.First) && this.Fits(pair.Second) &&
+            this.values[pair.First].Count >= MinValues && this.values[pair.Second].Count >= MinValues;
+
+        private bool Fits(int field) =>
+            this.outside[field] * ReadingsPerOutside <= this.readings &&
+            this.pointerHalves[field] * 2 <= this.nonZero[field];
+
+        /// <summary>Two fields watched together, and how often they agreed while either was not at rest.</summary>
+        private sealed class Pair
+        {
+            public Pair(int first, int second) => (this.First, this.Second) = (first, second);
+
+            public int First { get; }
+
+            public int Second { get; }
+
+            public int Agreed { get; set; }
+
+            public int Differed { get; set; }
+        }
+    }
+}
