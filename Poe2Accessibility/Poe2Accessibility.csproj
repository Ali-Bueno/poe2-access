<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- win-x64 RID so the Prismatoid native prism.dll is copied flat into the output folder. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Class libraries don't copy NuGet assemblies to bin by default; we need Prismatoid.dll + prism.dll there.
         Only the curated list in DeployToHost reaches the plugin folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Poe2Accessibility</RootNamespace>
    <NoWarn>1701;1702;1591</NoWarn>
    <!-- The mod's host (host/) and the folder it loads the plugin from. -->
    <HostRoot>$(MSBuildProjectDirectory)\..\host\</HostRoot>
    <PluginDeployDir>$(HostRoot)Poe2Access\bin\$(Configuration)\net10.0-windows\win-x64\Plugins\$(MSBuildProjectName)\</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Prismatoid" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(HostRoot)GameReader\GameReader.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <!-- The host loads Plugins\<Name>\<Name>.dll; ship the managed binding and the PRISM native next to it. -->
  <Target Name="DeployToHost" AfterTargets="Build">
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb;$(OutDir)Prismatoid.dll;$(OutDir)prism.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
    <!-- Offline menu catalog generated by tools/Poe2UiExtract from the game's .ui scripts (regenerate after patches). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\ui-catalog.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\ui-catalog.json')" />
    <!-- GGG's map cues by area, listed by hand from docs/research/map-hints-by-act.md. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\map-hints.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <!-- Named tiles (exits) from the vendored important_tgt_files.txt data file, then the ones it lacks and corrections to it, in the same format. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\important_tgt_files.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\landmarks.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <!-- Names objects show only in a WorldDescription, and lines the mod knows by their text (tools/Poe2UiExtract world-titles). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\world-titles.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <!-- The trials' icons and HUD formats per language (tools/Poe2UiExtract trial-data). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\trials.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\trials.json')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\area-names.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <!-- The radar table's boss names as the game names them (tools/Poe2UiExtract monster-names). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\monster-names.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\monster-names.json')" />
    <!-- Named map pieces and props from the terrain files (tools/Poe2UiExtract places). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\places.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\places.json')" />
    <!-- The mod's phrases in the game's other languages (tools/localization/phrases.py keeps them in step with the code). -->
    <ItemGroup><_PhraseTables Include="$(MSBuildProjectDirectory)\catalog\lang\*.json" /></ItemGroup>
    <Copy SourceFiles="@(_PhraseTables)" DestinationFolder="$(PluginDeployDir)catalog\lang" SkipUnchangedFiles="true" />
    <!-- Currency item names for inline item art in legends (tools/Poe2UiExtract item-names). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\item-names.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\item-names.json')" />
    <!-- The dat columns the plugin reads, found again by tools/Poe2UiExtract dat-columns (the launcher, after a patch). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\dat-columns.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\dat-columns.json')" />
    <!-- The total experience each level starts at (tools/Poe2UiExtract experience). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\experience.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\experience.json')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\dodge-timings.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\dodge-timings.txt')" />
    <!-- The Ids of the tables a player meets, to tell what a patch added (tools/Poe2UiExtract game-keys). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\code-fields.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\semantic-fields.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\game-keys.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\game-keys.txt')" />
    <!-- The game's numbers for animations and stats (tools/Poe2UiExtract game-ids). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\game-ids.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\game-ids.txt')" />
    <!-- When monster attacks land, from the game's animation data (tools/Poe2UiExtract hit-times). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\hit-times.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\hit-times.txt')" />
    <!-- The item each currency icon shows, for prices (tools/Poe2UiExtract currency-art). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\currency-art.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\currency-art.json')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\inline-icons.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\inline-icons.txt')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\boss-mechanics.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\boss-mechanics.txt')" />
    <!-- Harmful buffs' names per language (tools/Poe2UiExtract buff-names). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\buff-names.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\buff-names.json')" />
    <!-- Map objectives, contents and the Atlas's graphs (tools/Poe2UiExtract endgame). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\endgame.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\endgame.json')" />
    <!-- Class resources, limits, buff names and skill types (tools/Poe2UiExtract class-mechanics). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\class-mechanics.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\class-mechanics.json')" />
    <!-- Buffs from standing in harmful ground, for the hazard alarm (tools/Poe2UiExtract hazards). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\hazards.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\hazards.txt')" />
    <!-- How far each monster clip's blow reaches and lands (tools/Poe2UiExtract attack-reach). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\attack-reach.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\attack-reach.txt')" />
    <!-- The game's action names (tools/Poe2UiExtract action-types). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\action-types.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\action-types.txt')" />
    <!-- What the game draws before a monster skill lands, by skill (tools/Poe2UiExtract telegraph-skills). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\telegraph-skills.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\telegraph-skills.txt')" />
    <!-- The effect files those skills play, by .ao path (tools/Poe2UiExtract telegraph-effects). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\telegraph-effects.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\telegraph-effects.txt')" />
    <!-- Granted effects that deal Culling Strike, for the culling cue (tools/Poe2UiExtract cull-skills). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\cull-skills.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\cull-skills.txt')" />
    <!-- Item base id -> drop sample, generated by tools/Poe2UiExtract item-sounds from the game's tables. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\item-sounds.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\item-sounds.json')" />
    <!-- The game's own sounds, extracted locally by tools/Poe2UiExtract sounds (gitignored, never shipped), with their
         folders: items, loops, breakables. -->
    <ItemGroup><_GameSounds Include="$(MSBuildProjectDirectory)\sounds\**\*.wav" /></ItemGroup>
    <Copy SourceFiles="@(_GameSounds)" DestinationFiles="@(_GameSounds->'$(PluginDeployDir)sounds\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- The mod's own recorded sounds (shipped): the unexplored-area loop, the Diablo IV item set. -->
    <ItemGroup><_ModAssets Include="$(MSBuildProjectDirectory)\assets\**\*.wav" /></ItemGroup>
    <Copy SourceFiles="@(_ModAssets)" DestinationFiles="@(_ModAssets->'$(PluginDeployDir)assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
