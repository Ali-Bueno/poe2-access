<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- win-x64 RID so the Prismatoid native prism.dll is copied flat into the output folder. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Class libraries don't copy NuGet assemblies to bin by default; we need Prismatoid.dll + prism.dll there.
         Only the curated list in DeployToGameHelper reaches the plugin folder (never a second ImGui.NET). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Poe2Accessibility</RootNamespace>
    <NoWarn>1701;1702;1591</NoWarn>
    <!-- GameHelper2 host checkout (see external/) and the folder it loads plugins from. -->
    <GameHelperRoot>$(MSBuildProjectDirectory)\..\external\GameHelper2\</GameHelperRoot>
    <PluginDeployDir>$(GameHelperRoot)GameHelper\bin\$(Configuration)\net10.0-windows\win-x64\Plugins\$(MSBuildProjectName)\</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Prismatoid" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(GameHelperRoot)GameHelper\GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <!-- GameHelper2 discovers plugins as Plugins\<Name>\<Name>*.dll; ship the managed binding and the PRISM native next to it. -->
  <Target Name="DeployToGameHelper" AfterTargets="Build">
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb;$(OutDir)Prismatoid.dll;$(OutDir)prism.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
    <!-- Offline menu catalog generated by tools/Poe2UiExtract from the game's .ui scripts (regenerate after patches). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\ui-catalog.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\ui-catalog.json')" />
    <!-- Named tiles (exits) for areas GameHelper's Radar table lacks; same format as its important_tgt_files.txt. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\landmarks.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\area-names.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" />
    <!-- The mod's phrases in the game's other languages (tools/localization/phrases.py keeps them in step with the code). -->
    <ItemGroup><_PhraseTables Include="$(MSBuildProjectDirectory)\catalog\lang\*.json" /></ItemGroup>
    <Copy SourceFiles="@(_PhraseTables)" DestinationFolder="$(PluginDeployDir)catalog\lang" SkipUnchangedFiles="true" />
    <!-- Currency item names for inline item art in legends (tools/Poe2UiExtract item-names). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\item-names.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\item-names.json')" />
    <!-- The dat columns names are read from, found again by tools/Poe2UiExtract dat-columns (the launcher, after a patch). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\dat-columns.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\dat-columns.json')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\dodge-timings.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\dodge-timings.txt')" />
    <!-- When monster attacks land, from the game's animation data (tools/Poe2UiExtract hit-times). -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\hit-times.txt" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\hit-times.txt')" />
    <!-- Item base id -> drop sample, generated by tools/Poe2UiExtract item-sounds from the game's tables. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\catalog\item-sounds.json" DestinationFolder="$(PluginDeployDir)catalog" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\catalog\item-sounds.json')" />
    <!-- The game's own sounds, extracted locally by tools/Poe2UiExtract sounds (gitignored, never shipped). -->
    <ItemGroup><_GameSounds Include="$(MSBuildProjectDirectory)\sounds\*.wav" /></ItemGroup>
    <Copy SourceFiles="@(_GameSounds)" DestinationFolder="$(PluginDeployDir)sounds" SkipUnchangedFiles="true" />
    <ItemGroup><_ItemSounds Include="$(MSBuildProjectDirectory)\sounds\items\*.wav" /></ItemGroup>
    <Copy SourceFiles="@(_ItemSounds)" DestinationFolder="$(PluginDeployDir)sounds\items" SkipUnchangedFiles="true" />
  </Target>

</Project>
