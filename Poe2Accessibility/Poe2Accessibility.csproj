<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Loaded by the x64 host. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!-- PrismLibrary calls prism.dll through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Poe2Accessibility</RootNamespace>
    <HostRoot>$(MSBuildProjectDirectory)\..\host\</HostRoot>
    <PrismRuntime>$(MSBuildProjectDirectory)\..\third_party\prism\runtime\</PrismRuntime>
    <!-- Where DeployToHost puts the plugin: the development host's Plugins folder; the package passes its own. -->
    <PluginDeployDir>$(HostRoot)Poe2Access\bin\$(Configuration)\net10.0-windows\win-x64\Plugins\$(MSBuildProjectName)\</PluginDeployDir>
    <!-- The game's sounds, extracted locally into sounds\ (gitignored): the development host only, never a package. -->
    <DeployGameSounds>true</DeployGameSounds>
  </PropertyGroup>

  <ItemGroup>
    <!-- PRISM v0.18.3 (docs/proton.md): prism.dll and the Wine bridges' placeholders beside it, their Unix halves in wine\. -->
    <None Include="$(PrismRuntime)**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(HostRoot)GameReader\GameReader.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <!-- The host loads Plugins\<Name>\<Name>.dll. Beside it: PRISM as its release lays it out, every catalog file (each one's
       source and reader in catalog\README.md), the mod's recorded sounds in assets\ and the game's in sounds\. -->
  <Target Name="DeployToHost" AfterTargets="Build">
    <PropertyGroup>
      <_DeployDir>$([MSBuild]::EnsureTrailingSlash('$(PluginDeployDir)'))</_DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <_Deploy Include="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb;$(PrismRuntime)**\*" />
      <_Deploy Include="catalog\**\*" Exclude="catalog\README.md" DeployTo="catalog\" />
      <_Deploy Include="assets\**\*.wav" DeployTo="assets\" />
      <_Deploy Include="sounds\**\*.wav" DeployTo="sounds\" Condition="'$(DeployGameSounds)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_Deploy)" DestinationFiles="@(_Deploy->'$(_DeployDir)%(DeployTo)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
